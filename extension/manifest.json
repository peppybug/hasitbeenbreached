{
  "manifest_version": 3,
  "name": "Has it been Breached?",
  "short_name": "Breached?",
  "version": "1.0.0",
  "description": "See a company's data breach history while you browse. The site you're on is checked on your own device and never sent anywhere.",
  "homepage_url": "https://hasitbeenbreached.com/",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Has it been Breached?",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["https://hasitbeenbreached.com/*"]
}
